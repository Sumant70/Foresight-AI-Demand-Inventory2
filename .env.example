# =================================================================
# FORESIGHT AI — Configuration Template (.env.example)
# Copy this file to .env for custom deployment configurations.
# NEVER commit .env with secrets or credentials to version control.
# =================================================================

# Server Network Configuration
PORT=5000
HOST=0.0.0.0

# Session & Security Settings (Optional)
FORESIGHT_SESSION_HOURS=8
FORESIGHT_IDLE_MINUTES=30
FORESIGHT_SECURE_COOKIE=false

# Environment Mode: 'development' | 'production'
ENVIRONMENT=production
